---
import { Image } from 'astro:assets'

import supBg from '@images/stock/bgImg4.jpg'

import special from '@images/stock/uniform/1.png'
import special2 from '@images/stock/uniform/2.png'
import special3 from '@images/stock/uniform/3.png'
import special4 from '@images/stock/uniform/4.png'
import special5 from '@images/stock/uniform/5.png'
import special6 from '@images/stock/uniform/6.png'

const t1 =
  'Along with the listed array of security services, National 50 Security and Investigation, Inc. can provide, private investigation services that include civil process service, as well as criminal investigations, mobile and stationary surveillance capabilities and home and business protection with armed or unarmed personnel.'

const t2 =
  'National 50 Security and Investigations, Inc. can also provide medically trained personnel i.e.: CPR and Basic 1st First AID trained Officers.'
---

{/* White Section - Mission Statement*/}
<section class="relative bg-white px-4 py-14 lg:px-8 ">
  <Image
    src={supBg}
    alt="description"
    class="absolute inset-0 h-full w-full object-cover object-center"
  />
  <div class="my-8 grid grid-cols-6 place-content-center">
    <div class="-m-4">
      <Image
        src={special2}
        alt="Our Employees"
        class="fade-in-anim-left h-auto rounded-3xl object-cover object-center shadow-xl"
      />
    </div>
    <div class="m-auto">
      <Image
        src={special3}
        alt="Our Employees"
        class="fade-in-anim h-auto rounded-3xl object-cover object-center shadow-xl"
      />
    </div>
    <div class="-m-4">
      <Image
        src={special}
        alt="Our Employees"
        class="fade-in-anim-right h-auto rounded-3xl object-cover object-center shadow-xl"
      />
    </div>
    <div class="m-auto ">
      <Image
        src={special4}
        alt="Our Employees"
        class="fade-in-anim-left h-auto rounded-3xl object-cover object-center shadow-xl"
      />
    </div>
    <div class="-m-4">
      <Image
        src={special5}
        alt="Our Employees"
        class="fade-in-anim h-auto rounded-3xl object-cover object-center shadow-xl"
      />
    </div>
    <div class="m-auto">
      <Image
        src={special6}
        alt="Our Employees"
        class="fade-in-anim-right h-auto rounded-3xl object-cover object-center shadow-xl"
      />
    </div>
  </div>
  <div class="mx-auto max-w-screen-md lg:max-w-screen-xl">
    {/* Project description */}
    <div class="relative z-10 mx-auto mt-6 flex w-full flex-wrap justify-center">
      <div class="flex justify-center">
        <div class="mx-auto w-full place-content-center">
          <div class="fade-in-anim glass rounded-2xl p-8 text-center">
              <h1 class="text-3xl font-bold text-white text-center">
                SPECIALIZED SERVICES
              </h1>
            <p
              class="text-1xl mb-6 font-normal tracking-tight text-white lg:leading-tight"
            >
           
            </p>
            <p class="mb-6 text-lg font-normal tracking-tight text-white lg:leading-tight fade-in-anim-center">
              - Posted Security Officers. <br>
              - Patrol Security Officers. <br>
              - Loss Prevention. <br>
              - Personnel Security <br>
              - Property Security <br>
              - Large and Small Event Security <br>
            </p>
            <p class="mb-6 text-lg font-normal tracking-tight text-white lg:leading-tight fade-in-anim-center">
            Our Security Officers are licensed, highly trained and provide the best security service.
          </p>
          </div>
        </div>
      </div>
    </div>
    
  </div>
</section>

<style>
  .fade-in-anim-left {
    view-timeline: --subjectReveal block;
    animation-timeline: --subjectReveal;

    animation-name: fadein-left;
    animation-fill-mode: both;
    animation-duration: 1ms; /* Firefox requires this to apply the animation */
    animation-range: entry 25% cover 50%;
  }

  .fade-in-anim-right {
    view-timeline: --subjectReveal block;
    animation-timeline: --subjectReveal;

    animation-name: fadein-right;
    animation-fill-mode: both;
    animation-duration: 1ms; /* Firefox requires this to apply the animation */
    animation-range: entry 25% cover 50%;
  }

  .fade-in-anim-center {
    view-timeline: --subjectReveal block;
    animation-timeline: --subjectReveal;

    animation-name: fadein-center;
    animation-fill-mode: both;
    animation-duration: 1ms; /* Firefox requires this to apply the animation */
    animation-range: entry 15% cover 60%;
  }
  .fade-in-anim {
    view-timeline: --subjectReveal block;
    animation-timeline: --subjectReveal;

    animation-name: fadein;
    animation-fill-mode: both;
    animation-duration: 1ms; /* Firefox requires this to apply the animation */
    animation-range: entry 25% cover 50%;
  }

  @keyframes fadein-left {
    from {
      opacity: 0;
      transform: translateX(-300px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fadein-right {
    from {
      opacity: 0;
      transform: translateX(300px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fadein-center {
    from {
      opacity: 0;
      transform: translateY(40px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadein {
    from {
      opacity: 0;
      transform: scale(0.5);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
