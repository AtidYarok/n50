---
import { Image } from 'astro:assets'
import supBg from '@images/stock/bgImg4.jpg'

import bgImage1 from '@images/stock/comunications.webp'


---
{/* Blue Section Mission Statement - animated */}
<section class="relative bg-white py-10  md:py-12 ">
  <Image
                  src={supBg}
                  alt="description"
                  class="absolute inset-0 h-full w-full object-cover object-center"
                />
  <div class="mx-auto w-full max-w-screen-xl mt-12 space-y-12 lg:mt-16 lg:space-y-56 lg:pb-24">
        <div
          class="relative mx-auto max-w-lg lg:mx-0 lg:max-w-none"
        >
          <div
            class='left-40 relative h-64 w-full rounded-t-3xl bg-cover bg-center shadow-xl lg:h-full lg:w-[90%] lg:rounded-3xl lg:pt-[46%] fade-in-anim-right'
          >
            <Image
              src={bgImage1}
              alt='descript'
              class="absolute inset-0 h-full w-full rounded-t-3xl object-cover object-center lg:rounded-3xl"
            /> 
            
          </div>
          <div
            class:list={[
              'relative bottom-0 z-20 block h-auto w-full rounded-b-3xl glass p-6 shadow-xl sm:p-8 lg:absolute lg:-bottom-25 lg:w-3/4 lg:rounded-3xl lg:p-12 fade-in-anim-left',
            ]}
          >
            <div class="h-full lg:flex lg:flex-col lg:justify-between">
              <div class="fw-full text-center">
                <h3 class="text-3xl font-bold text-white lg:text-4xl">
                  24 Hour Communications
                </h3>
                
                <p class="mb-6 text-lg font-normal tracking-tight text-white lg:leading-tight fade-in-anim-center">
                  At National 50 Security, we recognize the importance of constant vigilance and rapid response in maintaining a secure environment. Our 24-Hour Communication Services ensure that you have continuous, round-the-clock support and monitoring. With our communication systems and dedicated team, we provide unwavering security and peace of mind every hour of the day.
                </p>
                
              </div>            
            </div>
          </div>
        </div>
  </div>
  </section>


<style>

h3 {
  padding-bottom: 1rem;
}
  .fade-in-anim-left {
    view-timeline: --subjectReveal block;
    animation-timeline: --subjectReveal;
  
    animation-name: fadein-left;
    animation-fill-mode: both;
    animation-duration: 1ms; /* Firefox requires this to apply the animation */
    animation-range: entry 25% cover 50% ;
  }

  .fade-in-anim-right {
    view-timeline: --subjectReveal block;
    animation-timeline: --subjectReveal;
  
    animation-name: fadein-right;
    animation-fill-mode: both;
    animation-duration: 1ms; /* Firefox requires this to apply the animation */
    animation-range: entry 25% cover 50% ;
  }

  .fade-in-anim-center {
    view-timeline: --subjectReveal block;
    animation-timeline: --subjectReveal;
  
    animation-name: fadein-center;
    animation-fill-mode: both;
    animation-duration: 1ms; /* Firefox requires this to apply the animation */
    animation-range: entry 15% cover 60% ;
  }
  .fade-in-anim {
    view-timeline: --subjectReveal block;
    animation-timeline: --subjectReveal;
  
    animation-name: fadein;
    animation-fill-mode: both;
    animation-duration: 1ms; /* Firefox requires this to apply the animation */
    animation-range: entry 25% cover 50% ;
  }
  
  @keyframes fadein-left {
  from {
    opacity: 0;
    transform: translateX(-300px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes fadein-right {
  from {
    opacity: 0;
    transform: translateX(300px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes fadein-center {
  from {
    opacity: 0;
    transform: translateY(40px);
    
  }

  to {
    opacity: 1;
    transform: translateY(0);
    
  }
}

@keyframes fadein {
  from {
    opacity: 0;
    transform: scale(0.5);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}


  
  </style>
